SALESFORCE_TOKEN_URL=https://your-salesforce-login-host.example/services/oauth2/token
SALESFORCE_CLIENT_ID=replace-with-client-id
SALESFORCE_CLIENT_SECRET=replace-with-client-secret
SALESFORCE_API_VERSION=replace-with-api-version
SALESFORCE_TEST_ACCOUNT_ID=replace-with-designated-test-account-id

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CUSTOMER_SYNC_TOPIC=northstar.customer-sync.v1
CUSTOMER_SYNC_ACK_TIMEOUT=5s

CUSTOMER_SYNC_LISTENER_ENABLED=false
CUSTOMER_SYNC_CONSUMER_GROUP=northstar.mock-erp.v1

PG_USERNAME=replace-with-your-postgres-username
PG_PASSWORD=replace-with-your-postgres-password
PG_DATABASE=mock_erp
ERP_DATABASE_URL=jdbc:postgresql://localhost:5432/mock_erp
